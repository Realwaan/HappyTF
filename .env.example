# ==============================================================================
# HappyTF Work OS Environment Configuration
# ==============================================================================
# ⚠️ SECURITY NOTE:
# NEVER expose server-only secrets (e.g. database passwords, private API tokens)
# with the 'NEXT_PUBLIC_' prefix. Only public, anon client keys may use NEXT_PUBLIC_
# as they are bundled into the client-side JavaScript.

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth & Realtime CDC)
# Optional - app automatically runs in rich in-memory Demo Mode if left empty.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # (Server-only for admin operations)

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Speed Layer Cache, Webhook Deduplication & Rate Limiting)
# Optional - automatically falls back to in-memory CacheEntry Map if empty.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ------------------------------------------------------------------------------
# 3. Slack Interactive Bot & Notifications (Optional)
# ------------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_DEFAULT_CHANNEL_ID=#eng-prod-alerts

# ------------------------------------------------------------------------------
# 4. Production Domain & Metadata (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://happytf.work
